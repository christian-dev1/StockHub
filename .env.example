# Copy to .env and adjust. Never commit the real .env file.

# PostgreSQL
POSTGRES_DB=stockhub
POSTGRES_USER=stockhub
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_PORT=5440

# Backend
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=prod
# Base64 encoded secret of at least 64 bytes (HS512). Generate with: openssl rand -base64 64
JWT_SECRET=replace-with-openssl-rand-base64-64
SWAGGER_ENABLED=true

# Frontends (host ports)
ANGULAR_PORT=4300
NEXT_PORT=3100
