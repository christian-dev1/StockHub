# Copy to .env and adjust. Never commit the real .env file.

# PostgreSQL
POSTGRES_DB=stockhub
POSTGRES_USER=stockhub
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_PORT=5440

# Backend
BACKEND_PORT=8080
# "demo" seeds two demo companies with one account per role (see README). Remove it for a real deployment.
SPRING_PROFILES_ACTIVE=prod,demo
# Base64 encoded secret of at least 64 bytes (HS512). Generate with: openssl rand -base64 64
JWT_SECRET=replace-with-openssl-rand-base64-64
SWAGGER_ENABLED=true

# Platform super admin created at first start (password: 10+ chars, letters and digits)
STOCKHUB_SUPERADMIN_EMAIL=superadmin@stockhub.local
STOCKHUB_SUPERADMIN_PASSWORD=change-me-SuperAdmin2026

# Frontends (host ports)
ANGULAR_PORT=4300
NEXT_PORT=3100

